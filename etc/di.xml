<?xml version="1.0"?>
<!--
/**
 * Panth Social Meta - DI configuration.
 *
 * OpenGraphResolver needs PageConfig to fall back to the controller-set
 * title/description on routes without a catalog/CMS entity in the
 * registry. Direct injection causes a circular dependency because
 * PageConfig::build() builds the layout, which instantiates the resolver
 * via the ViewModel during head assembly. Injecting a Proxy defers
 * resolution until the value is used.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Panth\SocialMeta\Model\Social\OpenGraphResolver">
        <arguments>
            <argument name="pageConfig" xsi:type="object">Magento\Framework\View\Page\Config\Proxy</argument>
        </arguments>
    </type>
    <type name="Panth\SocialMeta\Model\Social\OpenGraphResolver">
        <arguments>
            <argument name="articleProviderPool" xsi:type="object">Panth\SocialMeta\Model\Social\Article\ArticleProviderPool</argument>
        </arguments>
    </type>
    <type name="Panth\SocialMeta\Model\Social\Article\ArticleProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="registry_fallback" xsi:type="object">Panth\SocialMeta\Model\Social\Article\RegistryArticleProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Panth\SocialMeta\Model\Social\Article\RegistryArticleProvider">
        <arguments>
            <argument name="registryKeys" xsi:type="array">
                <item name="blog_post" xsi:type="string">current_panth_blog_post</item>
                <item name="blog_post_alt" xsi:type="string">current_blog_post</item>
                <item name="post" xsi:type="string">current_post</item>
            </argument>
        </arguments>
    </type>
</config>
